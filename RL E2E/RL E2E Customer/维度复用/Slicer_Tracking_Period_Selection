Slicer_Tracking_Period_Selection = 
// 功能：创建一个追踪期维度表，用于报表中的时间窗口筛选
// 用途：用户可以通过此表选择不同的分析时间跨度（如3个月、6个月等）
// 参数表名称：Tracking_Period
// 遵循通用参数表模板规范
DATATABLE(
    // 基础字段 - 必选字段
    "Period_ID", STRING,         // 主键标识，用于唯一标识每个时间窗口选项
    "Period_Label", STRING,      // 显示标签，在报表界面中向用户展示的时间跨度名称
    "Period_Sort", INTEGER,      // 排序顺序，控制选项在切片器中的显示顺序
    "Period_Description", STRING, // 详细描述，说明该追踪期的具体时间范围和业务含义
    
    // 扩展字段 - 可选字段
    "Period_IsDefault", BOOLEAN,  // 是否默认选中，TRUE表示用户打开报表时默认选择此期间
    "Period_IsActive", BOOLEAN,   // 是否激活状态，控制该期间选项是否可用
    "Period_Group", STRING,       // 分组标识，用于对相关期间进行逻辑分组
    
    // 自定义扩展字段 - 根据业务需求添加
    "Period_Value", STRING,       // 业务代码：对应图片中的3Months、6Months等实际参数值
    
    // 数据行
    {
        // 格式说明：每个花括号{}包含一行数据，顺序与上方字段定义一致
        
        // 3 Months - 近3个月
        {
            "3 Months",                  // 期间代码
            "3M",            // 期间显示名称
            10,                    // 排序顺序，从10开始
            "追踪近3个月的数据表现，适用于短期趋势分析和近期活动效果评估",  // 期间描述
            TRUE,                  // 默认选中，通常短期追踪是默认视图
            TRUE,                  // 激活状态，当前可用
            "短期追踪",            // 分组，属于短期时间窗口
            "3Months"              // 业务代码，对应源系统或图片中的值
        },
        
        // 6 Months - 近6个月
        {
            "6 Months",                  // 期间代码
            "6M",            // 期间显示名称
            11,                    // 排序顺序
            "追踪近6个月的数据表现，适用于中期趋势分析和半年度复盘",  // 期间描述
            FALSE,                 // 非默认选项
            TRUE,                  // 激活状态，当前可用
            "中期追踪",            // 分组，属于中期时间窗口
            "6Months"              // 业务代码，对应源系统或图片中的值
        },
        
        // 9 Months - 近9个月
        {
            "9 Months",                  // 期间代码
            "9M",            // 期间显示名称
            12,                    // 排序顺序
            "追踪近9个月的数据表现，适用于中长期趋势分析",  // 期间描述
            FALSE,                 // 非默认选项
            TRUE,                  // 激活状态，当前可用
            "中长期追踪",          // 分组，属于中长期时间窗口
            "9Months"              // 业务代码，对应源系统或图片中的值
        },
        
        // 12 Months - 近12个月
        {
            "12 Months",                 // 期间代码
            "12M",           // 期间显示名称
            13,                    // 排序顺序
            "追踪近12个月的数据表现，适用于长期趋势分析和年度同比评估",  // 期间描述
            FALSE,                 // 非默认选项
            TRUE,                  // 激活状态，当前可用
            "长期追踪",            // 分组，属于长期时间窗口
            "12 Months"            // 业务代码，对应源系统或图片中的值
        }
    }
)