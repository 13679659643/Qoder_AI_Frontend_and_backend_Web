Slicer_Is_Employee_Selection = 
	// 功能：创建一个员工身份维度表，用于报表中的用户身份筛选
	// 用途：用户可以通过此表选择是否为员工（Yes/No）进行分析
	// 参数表名称：Is_Employee
	// 遵循通用参数表模板规范
	DATATABLE(
	    // 基础字段 - 必选字段
	    "IsEmployee_ID", STRING,         // 主键标识，用于唯一标识每个身份选项
	    "IsEmployee_Label", STRING,      // 显示标签，在报表界面中向用户展示的身份名称
	    "IsEmployee_Sort", INTEGER,      // 排序顺序，控制选项在切片器中的显示顺序
	    "IsEmployee_Description", STRING, // 详细描述，说明该身份的具体特点和业务含义
	    // 扩展字段 - 可选字段
	    "IsEmployee_IsDefault", BOOLEAN,  // 是否默认选中，TRUE表示用户打开报表时默认选择此身份
	    "IsEmployee_IsActive", BOOLEAN,   // 是否激活状态，控制该身份选项是否可用
	    "IsEmployee_Group", STRING,       // 分组标识，用于对相关身份进行逻辑分组
	    // 自定义扩展字段 - 根据业务需求添加
	    "IsEmployee_Code", STRING,       // 业务代码：对应图片中的Yes、No字段值
	    // 数据行
	    {
	        // 格式说明：每个花括号{}包含一行数据，顺序与上方字段定义一致
	        // Yes - 是员工
	        {
	            "Yes",                   // 身份代码
	            "YES",                   // 身份显示名称
	            10,                      // 排序顺序，从10开始
	            "具有内部员工身份的用户或客户，通常在业务中享有员工专属折扣或内部购买权限",  // 身份描述
	            TRUE,                    // 默认选中
	            TRUE,                    // 激活状态，当前可用
	            "用户身份标识",          // 分组
	            "Yes"                    // 业务代码，对应源系统字段值
	        },
	        // No - 非员工
	        {
	            "No",                    // 身份代码
	            "NO",                    // 身份显示名称
	            20,                      // 排序顺序，步长为10，递增
	            "不具有员工身份的普通消费者或外部用户，按常规销售策略和价格体系进行管理",  // 身份描述
	            FALSE,                   // 非默认选项
	            TRUE,                    // 激活状态，当前可用
	            "用户身份标识",          // 分组
	            "No"                     // 业务代码，对应源系统字段值
	        }
	    }
	)