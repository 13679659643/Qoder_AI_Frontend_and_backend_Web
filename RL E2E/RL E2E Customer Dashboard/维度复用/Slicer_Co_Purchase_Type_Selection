Slicer_Co_Purchase_Type_Selection = 
// 功能：创建一个联合购买类型维度表，用于报表中的购买行为筛选
// 用途：用户可以通过此表选择不同的交叉销售类型（同单交叉、跨单交叉）进行分析
// 参数表名称：Co_Purchase_Type
// 遵循通用参数表模板规范
DATATABLE(
    // 基础字段 - 必选字段
    "CoPurchase_Type_ID", STRING,         // 主键标识，用于唯一标识每个联合购买类型选项
    "CoPurchase_Type_Label", STRING,      // 显示标签，在报表界面中向用户展示的类型名称
    "CoPurchase_Type_Sort", INTEGER,      // 排序顺序，控制选项在切片器中的显示顺序
    "CoPurchase_Type_Description", STRING, // 详细描述，说明该购买类型的具体特点和业务含义
    
    // 扩展字段 - 可选字段
    "CoPurchase_Type_IsDefault", BOOLEAN,  // 是否默认选中，TRUE表示用户打开报表时默认选择此类型
    "CoPurchase_Type_IsActive", BOOLEAN,   // 是否激活状态，控制该类型选项是否可用
    "CoPurchase_Type_Group", STRING,       // 分组标识，用于对相关类型进行逻辑分组
    
    // 自定义扩展字段 - 根据业务需求添加
    "CoPurchase_Type_Code", STRING,       // 业务代码：对应图片中的Same-Order Cross-Sell等
    
    // 数据行
    {
        // 格式说明：每个花括号{}包含一行数据，顺序与上方字段定义一致
        
        // Same-Order Cross-Sell - 同单交叉销售
        {
            "Same-Order Cross-Sell",          // 类型代码
            "Same-Order Cross-Sell", // 类型显示名称
            10,                    // 排序顺序，从10开始
            "客户在同一张订单中同时购买了多个不同品类或SKU的商品，体现即时连带销售效果",  // 类型描述
            TRUE,                  // 默认选中
            TRUE,                  // 激活状态，当前可用
            "客户购买行为",        // 分组
            "Same-Order Cross-Sell" // 业务代码，对应源系统字段值
        },
        
        // Cross-Order Cross-Sell - 跨单交叉销售
        {
            "Cross-Order Cross-Sell",         // 类型代码
            "Cross-Order Cross-Sell", // 类型显示名称
            20,                    // 排序顺序
            "客户在不同时间点的不同订单中购买了其他品类或SKU的商品，体现长期交叉销售和复购效果",  // 类型描述
            FALSE,                 // 非默认选项
            TRUE,                  // 激活状态，当前可用
            "客户购买行为",        // 分组
            "Cross-Order Cross-Sell" // 业务代码，对应源系统字段值
        }
    }
)