变更 3：Crowd TA Cell Font Color（ISINSCOPE 3 级）
================================================================================

Crowd TA Cell Font Color =
// ========================================
// 度量值: Crowd TA Cell Font Color
// 中文名: 人群单元格字体颜色
// Display Folder: Crowd TA > Formatting
// 用途: 根据矩阵视觉层级返回字体颜色
//       用于条件格式 → 字体颜色
// 矩阵结构: 行维度 = crowed_layer -> crowed_type -> crowed_name（三级）
// 颜色规则:
//   - 总计行 (Grand Total) -> #252423 (近黑，强调)
//   - 所有小计行和明细行     -> #5F6165 (深灰)
// 本次调整: 仅判断人群分层、类型与名称三个行字段，不再判断 category
// ========================================
    VAR __IsCrowdName = ISINSCOPE(a05_e2e_paid_media_crowed_data_d[crowed_name])
    VAR __IsCrowdType = ISINSCOPE(a05_e2e_paid_media_crowed_data_d[crowed_type])
    VAR __IsCrowdLayer = ISINSCOPE(a05_e2e_paid_media_crowed_data_d[crowed_layer])

    RETURN
        SWITCH(
            TRUE(),
            // ── 总计行：全部 ISINSCOPE = FALSE ──
            NOT(__IsCrowdLayer) && NOT(__IsCrowdType) && NOT(__IsCrowdName),
                "#252423",
            // ── 其余所有行（crowed_layer / crowed_type / crowed_name）──
            "#5F6165"
        )

