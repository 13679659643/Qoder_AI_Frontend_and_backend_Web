Dim_ColKPIs_BossCoreKPI_Overview = 
// ========================================
// 表: Dim_ColKPIs_BossCoreKPI_Overview
// 类型: 维度表（Dim_ 前缀），断开维度
// 用途: 定义 BOSS Core KPI 矩阵的列维度（StoreGroup > ColName）
// 范围: 子模块一 BOSS Core KPI
// 说明: 6 个店铺分组（TM / JD / RLE_CN / DY_Family / DY_W / DY_MN）
//       每个店铺分组下 3 列：Act / LY / vs LY
//       共 18 个列指标，对应事实表 store_name 字段筛选
//
// 店铺分组与 store_name 映射（对应事实表 a02_e2e_boss_performance_summary_d[store_name]）:
//   TM        → 天猫相关店铺
//   JD        → 京东相关店铺
//   RLE_CN    → 小红书中文店
//   DY_Family → 抖音家庭号
//   DY_W      → 抖音 W 店
//   DY_MN     → 抖音 MN 店
//
// 列类型说明（ColType）:
//   Act    → 实际值（当期）
//   LY     → 去年同期值（Last Year）
//   vs LY  → 与去年同比值（vs LY）
//              - 金额类（行维度 Metric_IsCurrencyAmount=TRUE）：今年 / 去年 - 1（percent_1dp）
//              - 数量类（integer）：今年 / 去年 - 1（percent_1dp）
//              - 比率类（SLS Penetration / Return% / Fulfillment%）：今年 - 去年（delta_bp，×10000 转 bp）
//
// 格式类型说明（由行维度 Dim_RowKPIs_BossCoreKPI_Overview 的三个字段决定）:
//   Metric_Format_Act   → 当期 行格式
//   Metric_Format_LY    → 去年同期 行格式（与 Act 一致）
//   Metric_Format_VsLY  → YOY/同比 行格式
//   currency       → 货币符号由币种切片器决定，千分位整数
//                    DAX: __CurrencySymbol & FORMAT(__Value, "#,##0")
//   percent_1dp    → 百分比1位小数（如 "58.3%"）
//                    格式: "#,##0.0%;#,##0.0%;0.0%"
//   integer        → 整数，千分位整数
//                    格式: "#,##0"
//   delta_bp       → 增减基点整数（如 "+120bp"）
//                    乘以 100 转 bp 的操作放在 Cell Display 度量中实现
//                    格式: "+#,##0bp;-#,##0bp;0bp"
//
// 同名区分机制（仅 ColName 追加空格，StoreGroup 不加空格）:
//   Power BI Sort by Column 要求同名字段只能绑定一个排序值，
//   通过在 ColName 末尾追加不同数量的空格，使各店铺同名值在底层字符串不同，
//   从而支持独立排序。
//   TM         → 0 个空格（基准）
//   JD         → 1 个空格
//   RLE_CN     → 2 个空格
//   DY_Family  → 3 个空格
//   DY_W       → 4 个空格
//   DY_MN      → 5 个空格
//   注: StoreGroup 字段为分组标题，本身各店铺值已天然不同（TM≠JD≠RLE_CN...），
//       无需追加空格区分；同店铺内 Act / LY / vs LY 因基础字符串不同天然区分，
//       追加空格数与所属店铺一致即可。
//
// 排序规则（不同店铺分组之间间隔 10，便于后续拓展字段无缝接入）:
//   StoreGroup_Sort:  TM=10, JD=20, RLE_CN=30, DY_Family=40, DY_W=50, DY_MN=60
//   ColName_Sort:     全局唯一，按店铺倍数区分，组内 Act/LY/vs LY 间隔 1
//                     TM=1,2,3  JD=11,12,13  RLE_CN=21,22,23
//                     DY_Family=31,32,33  DY_W=41,42,43  DY_MN=51,52,53
//   说明: 跨店铺间隔 10 通过 StoreGroup_Sort 步长 10 与 ColName_Sort 步长 10 体现；
//         同店铺内 3 列通过 ColName_Sort 末位 1,2,3 体现。
//
// 货币转换规则（与 Slicer_Currency_Selection 表配合）:
//   - 数据源默认为 RMB，转化为 USD 时除以固定汇率 7（Currency_ExchangeRate）
//   - 仅金额类 KPI（行维度 Metric_IsCurrencyAmount = TRUE）涉及汇率换算与币种符号拼接
//   - vs LY 同比值不受 Currency 切片器影响（同比为比率/差值，无金额单位）
//
// 颜色约定（参考 Dim_ColMetric_KpiBreakdown）:
//   正值（>0）：#1A9018 绿色
//   负值（<0）：#D64550 红色
//   零值（=0）：#E1C233 黄色
//   默认：#5f6165 深灰
// ========================================
DATATABLE(
    "StoreGroup_ID",         STRING,    // 店铺分组标识（TM / JD / RLE_CN / DY_Family / DY_W / DY_MN）
    "ColMetric_ID",          INTEGER,   // 主键标识（全局唯一）
    "StoreGroup",            STRING,    // Level 1: 店铺分组名（__SelR1），各店铺值天然不同，不加空格
    "ColName",               STRING,    // Level 2: 列名（Act / LY / vs LY，__SelR2），同名区分靠空格
    "StoreGroup_Sort",       INTEGER,   // Level 1 排序（TM=10, JD=20, ...步长 10 便于扩展）
    "ColName_Sort",          INTEGER,   // Level 2 排序（全局唯一，跨店铺步长 10，组内步长 1）
    "ColType",               STRING,    // 列类型标识：Act / LY / vs LY
    "Metric_ColorPositive",  STRING,    // 正值颜色
    "Metric_ColorNegative",  STRING,    // 负值颜色
    "Metric_ColorZero",      STRING,    // 零值颜色
    "Metric_ColorDefault",   STRING,    // 默认颜色
    {
        // ════════════════════════════════════════════════════════════════
        // TM 店铺分组（ColName 0 个空格，StoreGroup_Sort = 10）
        // ════════════════════════════════════════════════════════════════
        { "TM", 1,  "TM",       "Act",    10, 1,  "Act",   "#1A9018", "#D64550", "#E1C233", "#5f6165" },
        { "TM", 2,  "TM",       "LY",     10, 2,  "LY",    "#1A9018", "#D64550", "#E1C233", "#5f6165" },
        { "TM", 3,  "TM",       "vs LY",  10, 3,  "vs LY", "#1A9018", "#D64550", "#E1C233", "#5f6165" },

        // ════════════════════════════════════════════════════════════════
        // JD 店铺分组（ColName 1 个空格，StoreGroup_Sort = 20）
        // ════════════════════════════════════════════════════════════════
        { "JD", 4,  "JD",       "Act ",    20, 11, "Act",   "#1A9018", "#D64550", "#E1C233", "#5f6165" },
        { "JD", 5,  "JD",       "LY ",     20, 12, "LY",    "#1A9018", "#D64550", "#E1C233", "#5f6165" },
        { "JD", 6,  "JD",       "vs LY ",  20, 13, "vs LY", "#1A9018", "#D64550", "#E1C233", "#5f6165" },

        // ════════════════════════════════════════════════════════════════
        // RLE_CN 店铺分组（ColName 2 个空格，StoreGroup_Sort = 30）
        // ════════════════════════════════════════════════════════════════
        { "RLE_CN", 7,  "RLE_CN",       "Act  ",    30, 21, "Act",   "#1A9018", "#D64550", "#E1C233", "#5f6165" },
        { "RLE_CN", 8,  "RLE_CN",       "LY  ",     30, 22, "LY",    "#1A9018", "#D64550", "#E1C233", "#5f6165" },
        { "RLE_CN", 9,  "RLE_CN",       "vs LY  ",  30, 23, "vs LY", "#1A9018", "#D64550", "#E1C233", "#5f6165" },

        // ════════════════════════════════════════════════════════════════
        // DY_Family 店铺分组（ColName 3 个空格，StoreGroup_Sort = 40）
        // ════════════════════════════════════════════════════════════════
        { "DY_Family", 10, "DY_Family", "Act   ",    40, 31, "Act",   "#1A9018", "#D64550", "#E1C233", "#5f6165" },
        { "DY_Family", 11, "DY_Family", "LY   ",     40, 32, "LY",    "#1A9018", "#D64550", "#E1C233", "#5f6165" },
        { "DY_Family", 12, "DY_Family", "vs LY   ",  40, 33, "vs LY", "#1A9018", "#D64550", "#E1C233", "#5f6165" },

        // ════════════════════════════════════════════════════════════════
        // DY_W 店铺分组（ColName 4 个空格，StoreGroup_Sort = 50）
        // ════════════════════════════════════════════════════════════════
        { "DY_W", 13, "DY_W", "Act    ",    50, 41, "Act",   "#1A9018", "#D64550", "#E1C233", "#5f6165" },
        { "DY_W", 14, "DY_W", "LY    ",     50, 42, "LY",    "#1A9018", "#D64550", "#E1C233", "#5f6165" },
        { "DY_W", 15, "DY_W", "vs LY    ",  50, 43, "vs LY", "#1A9018", "#D64550", "#E1C233", "#5f6165" },

        // ════════════════════════════════════════════════════════════════
        // DY_MN 店铺分组（ColName 5 个空格，StoreGroup_Sort = 60）
        // ════════════════════════════════════════════════════════════════
        { "DY_MN", 16, "DY_MN", "Act     ",    60, 51, "Act",   "#1A9018", "#D64550", "#E1C233", "#5f6165" },
        { "DY_MN", 17, "DY_MN", "LY     ",     60, 52, "LY",    "#1A9018", "#D64550", "#E1C233", "#5f6165" },
        { "DY_MN", 18, "DY_MN", "vs LY     ",  60, 53, "vs LY", "#1A9018", "#D64550", "#E1C233", "#5f6165" }
    }
)
